# GPU environment for the N = 30 arm. Build: docker build -f Dockerfile.gpu -t v10-gpu .
# Run:   docker run --gpus all v10-gpu python3 run_confirmatory.py --timing --register N30_m1 --backend cupy
FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip && rm -rf /var/lib/apt/lists/*
WORKDIR /v10
COPY requirements.lock requirements-gpu.txt ./
RUN pip3 install --no-cache-dir --break-system-packages -r requirements-gpu.txt
COPY . .
